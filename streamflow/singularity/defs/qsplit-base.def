Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer QSplit

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1
    export QSPLIT_BACKEND=classic
    export PYTHONPATH=/workspace
    export QSPLIT_CLI_SPLIT=/workspace/qsplit/cwl/cli/split.py
    export QSPLIT_CLI_SCATTER=/workspace/qsplit/cwl/cli/scatter.py
    export QSPLIT_CLI_AGGREGATE=/workspace/qsplit/cwl/cli/aggregate.py

%files
    pyproject.toml /workspace/pyproject.toml
    qsplit /workspace/qsplit

%post
    set -e
    apt-get update
    apt-get install -y --no-install-recommends libgomp1
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --upgrade pip setuptools wheel
    python3 -m pip install "/workspace"
    cat > /usr/local/bin/cli_split <<'SH'
#!/bin/sh
exec python3 "$QSPLIT_CLI_SPLIT" "$@"
SH
    cat > /usr/local/bin/cli_scatter <<'SH'
#!/bin/sh
exec python3 "$QSPLIT_CLI_SCATTER" "$@"
SH
    cat > /usr/local/bin/cli_aggregate <<'SH'
#!/bin/sh
exec python3 "$QSPLIT_CLI_AGGREGATE" "$@"
SH
    chmod +x /usr/local/bin/cli_split /usr/local/bin/cli_scatter /usr/local/bin/cli_aggregate


%runscript
    exec python3 "$@"
