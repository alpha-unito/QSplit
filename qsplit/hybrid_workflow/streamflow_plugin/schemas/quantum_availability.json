{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsplit.local/plugins/schemas/connectors/quantum_availability.json",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["ibm", "dwave", "iqm"],
      "description": "Quantum provider to probe"
    },
    "backend": {
      "type": "string",
      "description": "Backend/solver name (provider-specific). If empty, a provider default is used."
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "ibm": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "instance": { "type": "string" },
        "channel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dwave": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "endpoint": { "type": "string" },
        "solver_filters": { "type": "object" }
      },
      "additionalProperties": true
    },
    "iqm": {
      "type": "object",
      "properties": {
        "iqm_server_url": { "type": "string" },
        "token": { "type": "string" },
        "tokens_file": { "type": "string" },
        "quantum_computer": { "type": "string" }
      },
      "required": ["iqm_server_url"],
      "additionalProperties": false
    }
  },
  "required": ["provider"],
  "additionalProperties": false
}